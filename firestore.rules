rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 1. USER PROFILES  (identity is the Firebase Auth UID)
    // =========================================================================
    match /users/{userId} {
      // Any authenticated user can read public user profiles
      allow read: if request.auth != null;

      // A user may write their own UID-keyed profile document.
      allow create, update, delete: if request.auth != null
                                    && request.auth.uid == userId;

      // Legacy phone-keyed mirror documents (users/{normalizedPhone}).
      // They are only writable by the authenticated owner of that profile, so
      // nobody can overwrite somebody else's phone-keyed profile.
      allow create, update: if request.auth != null
                            && userId != request.auth.uid
                            && request.resource.data.uid == request.auth.uid;

      // Blocked-user lists stay private to their owner
      match /blocked/{blockedId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }
    }

    // Phone number to UID lookup index (used to resolve a phone to a user).
    // Readable by any signed-in user, but a user may only claim their own entry.
    match /phoneIndex/{phone} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                            && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // =========================================================================
    // 2. WHATSAPP-STYLE PRIVATE CONVERSATIONS  (participants are UIDs)
    // =========================================================================
    match /conversations/{conversationId} {

      // A user can READ a conversation ONLY when:
      // - authenticated
      // - request.auth.uid is in resource.data.participants
      allow read: if request.auth != null
                  && resource.data.participants is list
                  && request.auth.uid in resource.data.participants;

      // A user can CREATE a conversation ONLY when:
      // - authenticated
      // - request.auth.uid is included in request.resource.data.participants
      // - participants is 1 (My Notes) or 2 (1-on-1 private chat) UIDs
      allow create: if request.auth != null
                    && request.resource.data.participants is list
                    && request.resource.data.participants.size() >= 1
                    && request.resource.data.participants.size() <= 2
                    && request.auth.uid in request.resource.data.participants;

      // A participant can UPDATE conversation metadata (lastMessage, pin,
      // disappearing duration, etc.) but cannot change the participants list.
      allow update: if request.auth != null
                    && resource.data.participants is list
                    && request.auth.uid in resource.data.participants
                    && request.resource.data.participants is list
                    && request.resource.data.participants == resource.data.participants;

      // Deleting conversations is disallowed
      allow delete: if false;

      // -----------------------------------------------------------------------
      // 2b. MESSAGES SUBCOLLECTION: conversations/{conversationId}/messages/{messageId}
      // -----------------------------------------------------------------------
      match /messages/{messageId} {

        // Only conversation participants can read messages
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;

        // Only participants can send, and senderId must be the caller
        allow create: if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
                      && request.resource.data.senderId == request.auth.uid;

        // Authorship is immutable: senderId, receiverId and createdAt can never
        // be rewritten. Any participant may react or hide a message for
        // themselves, but only the original sender may change the text.
        allow update: if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
                      && request.resource.data.senderId == resource.data.senderId
                      && request.resource.data.receiverId == resource.data.receiverId
                      && request.resource.data.createdAt == resource.data.createdAt
                      && (request.resource.data.text == resource.data.text
                          || resource.data.senderId == request.auth.uid);

        allow delete: if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
                      && resource.data.senderId == request.auth.uid;
      }
    }

    // =========================================================================
    // 3. STATUSES  (owner is identified by the Firebase UID in userId)
    // =========================================================================
    match /statuses/{statusId} {
      // Every authenticated user can watch status updates
      allow read: if request.auth != null;

      // A status can only be created on behalf of the authenticated user
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;

      // Owner can edit/delete their own status; nobody else can.
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;

      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    // =========================================================================
    // 4. CALL HISTORY  (participants are UIDs, same privacy as conversations)
    // =========================================================================
    match /calls/{callId} {
      // Only the two participants of a call can see that call
      allow read: if request.auth != null
                  && resource.data.participants is list
                  && request.auth.uid in resource.data.participants;

      // A call entry can only be created on behalf of the authenticated caller
      allow create: if request.auth != null
                    && request.resource.data.participants is list
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.callerUid == request.auth.uid;

      allow update, delete: if false;
    }

    // =========================================================================
    // 4b. CALL INVITATIONS  (live ringing/accept/decline signalling)
    //     Both participants may read; only status fields change after create.
    // =========================================================================
    match /call_invitations/{invitationId} {
      allow read: if request.auth != null
                  && (resource.data.callerUid == request.auth.uid
                      || resource.data.calleeUid == request.auth.uid);

      // A caller may only invite on their own behalf (and must invite
      // someone else).
      allow create: if request.auth != null
                    && request.resource.data.callerUid == request.auth.uid
                    && request.resource.data.calleeUid is string
                    && request.resource.data.calleeUid != request.auth.uid
                    && request.resource.data.status == 'ringing'
                    && request.resource.data.channelName is string;

      // Either participant may advance the status (accepted/declined/
      // cancelled/ended) — the participants themselves never change.
      allow update: if request.auth != null
                    && (resource.data.callerUid == request.auth.uid
                        || resource.data.calleeUid == request.auth.uid)
                    && request.resource.data.callerUid == resource.data.callerUid
                    && request.resource.data.calleeUid == resource.data.calleeUid;

      allow delete: if false;
    }

    // =========================================================================
    // 5. USER REPORTS  (a reporter may file a report, nobody may read them)
    // =========================================================================
    match /reports/{reportId} {
      allow read: if false;
      allow create: if request.auth != null
                    && request.resource.data.reporterId == request.auth.uid;
      allow update, delete: if false;
    }

    // =========================================================================
    // 6. LEGACY COLLECTIONS  (read-only for authenticated users during migration)
    //    No new writes are allowed. Existing data is preserved untouched.
    // =========================================================================
    match /chats/{chatId} {
      allow read: if request.auth != null;
      allow write: if false;
      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    match /contacts/{contactId} {
      allow read: if request.auth != null;
      allow write: if false;
      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
